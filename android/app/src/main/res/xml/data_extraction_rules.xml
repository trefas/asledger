<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Финансовые данные не выгружаются в облако и не переносятся автоматически. -->
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
