root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = android_studio
max_line_length = 120
# Composable-функции по соглашению Compose пишутся с заглавной буквы.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Форматирование сигнатур и переносов оставляем IDE/ktlintFormat: правила
# конфликтуют с принятым в Compose вертикальным стилем цепочек Modifier.
ktlint_standard_multiline-expression-wrapping = disabled
ktlint_standard_function-signature = disabled
ktlint_standard_class-signature = disabled
ktlint_standard_chain-method-continuation = disabled
