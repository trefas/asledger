root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Go использует табуляцию
[*.go]
indent_style = tab
indent_size = 4

[Makefile]
indent_style = tab

# Технические файлы — два пробела
[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.svg]
insert_final_newline = false
