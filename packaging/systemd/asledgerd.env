# Параметры службы asledgerd.
#
# Файл подключается юнитом как EnvironmentFile. Значения перекрывают
# умолчания конфигурации; флаги командной строки в юните имеют приоритет выше.
#ASLEDGER_WEB_ADDR=:8777
#ASLEDGER_API_ADDR=:8778
#ASLEDGER_DB_PATH=/var/lib/asledger/asledger.db
#ASLEDGER_ASSETS_DIR=/usr/local/share/asledger/assets/logo
#ASLEDGER_CHARTS_DIR=/usr/local/share/asledger/templates/charts
#ASLEDGER_LOG_LEVEL=info
#ASLEDGER_LOG_FORMAT=text

# Секреты в этом файле не хранятся. Для службы используйте
# LoadCredential=asledger-password:... в asledgerd.service; при ручном
# запуске допустимы -password-file/-password-fd.
#ASLEDGER_ALLOW_PLAINTEXT=0
